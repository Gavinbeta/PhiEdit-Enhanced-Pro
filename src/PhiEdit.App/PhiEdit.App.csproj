<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PhiEdit.App</RootNamespace>
    <AssemblyName>PhiEdit.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 统一输出目录：无论按项目还是按解决方案构建，产物都落在同一目录，避免启动到旧版本。 -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhiEdit.App</RootNamespace>
    <ApplicationTitle>PhiEdit Enhanced Pro</ApplicationTitle>
    <Version>1.3.0-BETA1</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyInformationalVersion>1.3.2_BETA9</AssemblyInformationalVersion>
    <Company>PhiEdit Enhanced Pro</Company>
    <Description>基于 Re:PhiEdit 逻辑重制的 WinUI 3 制谱器</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhiEdit.Core\PhiEdit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 内置音符资源包：随程序分发，可在设置页查看与切换 -->
    <Content Include="Assets\NoteSkins\*.zip" CopyToOutputDirectory="PreserveNewest" />
    <!-- 原版默认 RPE 贴图：实时预览层按参考源码还原时使用 -->
    <Content Include="Assets\RpeTextures\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 默认谱面：启动即加载，便于对照原版渲染 -->
    <Content Include="Assets\SampleCharts\*.pez" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
