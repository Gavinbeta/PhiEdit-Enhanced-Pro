<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PhiEdit.App.Views.LandingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏：上组（谱面库 / 开始 / 渲染），下组（设置 / 关于 / 退出） -->
        <Grid Grid.Column="0" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 品牌 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="20,22,16,26">
                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="17"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="PhiEdit" FontSize="15" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="Enhanced Pro" FontSize="11"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- 主导航 -->
            <StackPanel Grid.Row="1" Spacing="4" Margin="12,0,12,0">
                <Button x:Name="NavLibrary" Tag="library" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,10" Foreground="{ThemeResource TextPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" />
                        <TextBlock Text="谱面库" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavStart" Tag="start" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,10" Foreground="{ThemeResource TextPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE768;" FontSize="18" />
                        <TextBlock Text="开始" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavRender" Tag="render" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,10" Foreground="{ThemeResource TextPrimaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7B3;" FontSize="18" />
                        <TextBlock Text="渲染" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 底部导航 -->
            <StackPanel Grid.Row="2" Spacing="2" Margin="12,0,12,16">
                <Rectangle Height="1" Fill="{ThemeResource StrokeBrush}" Margin="6,0,6,10" />
                <Button x:Name="NavSettings" Tag="settings" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,9" Foreground="{ThemeResource TextSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                        <TextBlock Text="设置" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAbout" Tag="about" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,9" Foreground="{ThemeResource TextSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7F2;" FontSize="16" />
                        <TextBlock Text="关于" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavExit" Tag="exit" Click="OnNavigateClick" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                        CornerRadius="8" Padding="14,9" Foreground="{ThemeResource TextSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                        <TextBlock Text="退出" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 右侧内容区：顶部无搜索栏 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="44,40,44,40" MaxWidth="980" HorizontalAlignment="Left">

                <!-- 开始页 -->
                <StackPanel x:Name="StartPanel" Visibility="Visible">
                    <TextBlock Text="欢迎使用 PhiEdit Enhanced Pro" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="原生 Windows 制谱器 · 编辑与实时预览一体化" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="快速开始" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="从工具栏新建谱面，或打开已有的 RPE JSON / PEZ 谱面包。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button Content="新建谱面" Click="OnNewChartClick" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="打开谱面" Click="OnOpenChartClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="进入编辑器" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="继续上次打开的谱面，直接进入编辑工作区。"
                                       FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="开始编辑" Click="OnStartClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 谱面库页 -->
                <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                    <TextBlock Text="谱面库" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="本地谱面管理（规划中）" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="即将推出" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="LibraryHint" Text="谱面库功能尚未实现。你仍可通过工具栏打开本地谱面文件。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="打开本地谱面" Click="OnOpenChartClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 渲染页 -->
                <StackPanel x:Name="RenderPanel" Visibility="Collapsed">
                    <TextBlock Text="渲染" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="实时预览与导出（规划中）" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="编辑区已嵌入实时预览；独立预览窗口可从工具栏打开。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="打开预览窗口" Click="OnOpenPreviewClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 关于页 -->
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                    <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="PhiEdit Enhanced Pro" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="版本信息" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AboutVersion" Text="v1.8.0_BETA1" FontSize="14"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="基于 Re:PhiEdit Next 逻辑重制的原生 WinUI 3 制谱器。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="参考源码遵循 PolyForm-Noncommercial-1.0.0 许可。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
