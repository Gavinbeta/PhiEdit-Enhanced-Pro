<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhiEdit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PhiEdit.App.Controls"
        xmlns:views="using:PhiEdit.App.Views"
        Title="PhiEdit Enhanced Pro">

    <Grid x:Name="RootLayout"
          Background="{ThemeResource AppBackgroundBrush}"
          RowDefinitions="Auto,Auto,*,Auto">

        <!-- 标题栏 -->
        <Grid x:Name="TitleBarHost" Grid.Row="0" Height="44" Background="Transparent">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,0,16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="22" Height="22" CornerRadius="5" Background="{ThemeResource AccentBrush}">
                        <TextBlock Text="P" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" FontSize="13" Foreground="#FF10131A" />
                    </Border>
                    <TextBlock Text="PhiEdit Enhanced Pro" FontWeight="SemiBold" FontSize="14"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="DocumentTitle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                           FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" Text="未命名" />
                <TextBlock x:Name="BuildVersion" Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource TextSecondaryBrush}" Text="v1.10.0_BETA4" />
            </Grid>
        </Grid>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}"
                BorderThickness="0,1,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                <StackPanel Orientation="Horizontal" Padding="10,6" Spacing="2">
                    <Button x:Name="NewButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnNewClick"
                            ToolTipService.ToolTip="新建谱面">
                        <FontIcon Glyph="&#xE710;" FontSize="16" />
                    </Button>
                    <Button x:Name="OpenButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnOpenClick"
                            ToolTipService.ToolTip="打开谱面 (Ctrl+O)">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                    </Button>
                    <Button x:Name="ImportPezButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnImportPezClick"
                            ToolTipService.ToolTip="导入 PEZ 谱面包">
                        <TextBlock Text="PEZ" FontSize="11" />
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnSaveClick"
                            ToolTipService.ToolTip="保存谱面 (Ctrl+S)">
                        <FontIcon Glyph="&#xE74E;" FontSize="16" />
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnExportClick"
                            ToolTipService.ToolTip="导出谱面">
                        <FontIcon Glyph="&#xE896;" FontSize="16" />
                    </Button>

                    <Rectangle Width="1" Height="20" Margin="8,0" Fill="{ThemeResource StrokeBrush}" />

                    <Button x:Name="UndoButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnUndoClick"
                            ToolTipService.ToolTip="撤销 (Ctrl+Z)">
                        <FontIcon Glyph="&#xE7A7;" FontSize="16" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnRedoClick"
                            ToolTipService.ToolTip="重做 (Ctrl+Y)">
                        <FontIcon Glyph="&#xE895;" FontSize="16" />
                    </Button>

                    <Rectangle Width="1" Height="20" Margin="8,0" Fill="{ThemeResource StrokeBrush}" />

                    <Button x:Name="PlayButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnPlayClick"
                            ToolTipService.ToolTip="播放 / 暂停 (空格)">
                        <FontIcon x:Name="PlayGlyph" Glyph="&#xE768;" FontSize="16" />
                    </Button>
                    <Button x:Name="StopButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnStopClick"
                            ToolTipService.ToolTip="回到开头">
                        <FontIcon Glyph="&#xE71A;" FontSize="16" />
                    </Button>
                    <Button x:Name="PreviewButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnPreviewClick"
                            ToolTipService.ToolTip="打开实时预览窗口">
                        <FontIcon Glyph="&#xE7B3;" FontSize="16" />
                    </Button>
                    <Button x:Name="GridOverlayButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnGridOverlayClick"
                            ToolTipService.ToolTip="显示/隐藏编辑网格（透过网格查看实时预览）">
                        <FontIcon x:Name="GridOverlayGlyph" Glyph="&#xE8A4;" FontSize="16" />
                    </Button>

                    <Rectangle Width="1" Height="20" Margin="8,0" Fill="{ThemeResource StrokeBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="判定线" Style="{StaticResource StatusTextStyle}" />
                        <ComboBox x:Name="LineSelector" MinWidth="130" SelectionChanged="OnLineSelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="事件层" Style="{StaticResource StatusTextStyle}" />
                        <StackPanel x:Name="LayerButtons" Orientation="Horizontal" Spacing="2" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="每拍细分数" Style="{StaticResource StatusTextStyle}" />
                        <NumberBox x:Name="DivisionBox" Width="76" Minimum="1" Maximum="32" SpinButtonPlacementMode="Hidden"
                                   ValueChanged="OnDivisionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="竖线数" Style="{StaticResource StatusTextStyle}" />
                        <NumberBox x:Name="GridCountBox" Width="76" Minimum="2" Maximum="101" SpinButtonPlacementMode="Hidden"
                                   ValueChanged="OnGridCountChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="吸附竖线" Style="{StaticResource StatusTextStyle}" />
                        <ToggleSwitch x:Name="SnapToggle" IsOn="True" MinWidth="40" Toggled="OnSnapToggled" />
                    </StackPanel>
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButtonStyle}" Click="OnSettingsClick"
                            Margin="10,0,0,0" ToolTipService.ToolTip="设置">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主体：左侧编辑区（音符区 + 判定线区，从正中间分开），右侧属性面板 -->
        <Grid x:Name="WorkspaceArea" Grid.Row="2" ColumnDefinitions="*,Auto,360">

            <!-- 音符区与判定线区由同一块 CanvasControl 绘制，只有一条可拖动的透明分隔条。
                 底层铺满实时预览画布（锁定比例居中、黑边填充），上层半透明编辑网格叠在其上。 -->
            <Grid x:Name="EditorArea" Grid.Column="0" SizeChanged="OnEditorAreaSizeChanged">
                <controls:PreviewCanvas x:Name="EmbeddedPreview" />
                <controls:EditorCanvas x:Name="EditorCanvas" TransparentBackground="True" />
                <controls:ThinSplitter x:Name="EditorSplitter" Width="6" HorizontalAlignment="Center"
                                       VerticalAlignment="Stretch" />
            </Grid>

            <controls:ThinSplitter Grid.Column="1" x:Name="InspectorSplitter" />

            <Border Grid.Column="2" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="8,8,8,4">
                        <ToggleButton x:Name="TabEdit" Style="{StaticResource InspectorTabStyle}" Click="OnTabClick"
                                      Tag="edit" IsChecked="True" Content="编辑" IsEnabled="False" />
                        <ToggleButton x:Name="TabLines" Style="{StaticResource InspectorTabStyle}" Click="OnTabClick"
                                      Tag="lines" Content="判定线" />
                        <ToggleButton x:Name="TabChart" Style="{StaticResource InspectorTabStyle}" Click="OnTabClick"
                                      Tag="chart" Content="谱面" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                      <Grid>
                        <!-- 未选中任何对象 -->
                        <StackPanel x:Name="EditHintPanel" Padding="14" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="编辑" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="未选中音符或事件。按 Q/W/E 在指针处放置 Tap/Drag/Flick，按 R 两段式放置 Hold 或事件条。"
                                       Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="提示：按住 Shift 拖动可框选，Ctrl+单击可加选，Ctrl+C / Ctrl+V 复制粘贴，Ctrl+M 镜像。"
                                       Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 音符属性 -->
                        <StackPanel x:Name="NotesPanel" Padding="14" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="音符编辑" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="类型" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="NoteTypeBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnNoteTypeChanged">
                                    <ComboBoxItem Content="Tap" Tag="1" />
                                    <ComboBoxItem Content="Hold" Tag="2" />
                                    <ComboBoxItem Content="Flick" Tag="3" />
                                    <ComboBoxItem Content="Drag" Tag="4" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="起始时间" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NoteStartBeatBox" PlaceholderText="整数:分子/分母"
                                         LostFocus="OnNoteBeatEdited" />
                            </StackPanel>
                            <StackPanel x:Name="NoteEndBeatPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="结束时间" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="NoteEndBeatBox" PlaceholderText="整数:分子/分母"
                                         LostFocus="OnNoteBeatEdited" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="X坐标" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NotePositionXBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNotePositionXChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="下落朝向" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="NoteFallDirectionBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnNoteFallDirectionChanged">
                                    <ComboBoxItem Content="Up" Tag="1" />
                                    <ComboBoxItem Content="Down" Tag="0" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="速度" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NoteSpeedBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNoteSpeedChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Y值偏移" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NotePositionYBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNotePositionYChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="真值" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="NoteTruthBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnNoteTruthChanged">
                                    <ComboBoxItem Content="Real" Tag="1" />
                                    <ComboBoxItem Content="Fake" Tag="0" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="宽度" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NoteWidthBox" Minimum="0.1" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNoteWidthChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="可视时间/秒" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NoteVisibleTimeBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNoteVisibleTimeChanged" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="透明度" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="NoteAlphaBox" Minimum="0" Maximum="255" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnNoteAlphaChanged" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*" Margin="0,6,0,0">
                                <Button Grid.Column="0" Content="取消" Margin="0,0,4,0" Click="OnCancelNoteClick"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" Content="删除" Margin="4,0,4,0" Click="OnDeleteNoteClick"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="保存" Margin="4,0,0,0" Click="OnSaveNoteClick"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>

                        <!-- 事件属性 -->
                        <StackPanel x:Name="EventsPanel" Padding="14" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="EventInspectorTitle" Text="事件属性" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="起始时间" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventStartBeatBox" PlaceholderText="整数:分子/分母"
                                         LostFocus="OnEventBeatEdited" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="结束时间" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventEndBeatBox" PlaceholderText="整数:分子/分母"
                                         LostFocus="OnEventBeatEdited" />
                            </StackPanel>
                            <StackPanel x:Name="EventStartValuePanel" Spacing="6">
                                <TextBlock x:Name="EventStartValueLabel" Text="起点值" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="EventStartValueBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnEventValueChanged" />
                            </StackPanel>
                            <StackPanel x:Name="EventEndValuePanel" Spacing="6">
                                <TextBlock x:Name="EventEndValueLabel" Text="终点值" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="EventEndValueBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnEventValueChanged" />
                            </StackPanel>
                            <StackPanel x:Name="EventColorValuePanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="起始颜色" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventStartColorBox" LostFocus="OnEventColorEdited" />
                                <TextBlock Text="结束颜色" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventEndColorBox" LostFocus="OnEventColorEdited" />
                            </StackPanel>
                            <StackPanel x:Name="EventTextValuePanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="起始文字" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventStartTextBox" LostFocus="OnEventTextEdited" />
                                <TextBlock Text="结束文字" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="EventEndTextBox" LostFocus="OnEventTextEdited" />
                            </StackPanel>
                            <StackPanel x:Name="EventShaderPanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock Text="类型" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="EventShaderTypeBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnEventShaderTypeChanged">
                                    <ComboBoxItem Content="chromatic" />
                                    <ComboBoxItem Content="blur" />
                                    <ComboBoxItem Content="glitch" />
                                    <ComboBoxItem Content="custom" />
                                </ComboBox>
                                <Button x:Name="EventShaderCodeButton" Content="Shader 代码编辑器..."
                                        Click="OnEventShaderCodeClick" HorizontalAlignment="Stretch" />
                                <CheckBox x:Name="EventShaderGlobalBox" Content="全局（包含游戏 UI）"
                                          Checked="OnEventShaderFlagChanged" Unchecked="OnEventShaderFlagChanged" />
                                <CheckBox x:Name="EventShaderAutoAlignBox" Content="移动时参数自动对齐"
                                          Checked="OnEventShaderFlagChanged" Unchecked="OnEventShaderFlagChanged" />
                                <TextBlock Text="顺序" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="EventShaderOrderBox" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnEventShaderNumberChanged" />
                                <TextBlock Text="参数" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="EventShaderParameterBox" HorizontalAlignment="Stretch"
                                          SelectionChanged="OnEventShaderParameterChanged">
                                    <ComboBoxItem Content="sampleCount" />
                                    <ComboBoxItem Content="intensity" />
                                    <ComboBoxItem Content="speed" />
                                </ComboBox>
                                <Button Content="编辑参数" Click="OnEventShaderCodeClick" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="绑定组编号" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="EventLinkGroupBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnEventLinkGroupChanged" />
                            </StackPanel>

                            <CheckBox x:Name="EventHookedCheck" Content="钩定（首尾同步）"
                                      Checked="OnEventHookedChanged" Unchecked="OnEventHookedChanged" />

                            <StackPanel x:Name="EventEasingSection" Spacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="缓动类型" Style="{StaticResource FieldLabelStyle}" />
                                    <ComboBox x:Name="EventEasingBox" HorizontalAlignment="Stretch"
                                              MaxDropDownHeight="360"
                                              SelectionChanged="OnEventEasingChanged" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,6,0">
                                        <TextBlock Text="缓动左边界" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="EventEasingLeftBox" Minimum="0" Maximum="1" SmallChange="0.05"
                                                   SpinButtonPlacementMode="Hidden" ValueChanged="OnEventEasingBoundChanged" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6" Margin="6,0,0,0">
                                        <TextBlock Text="缓动右边界" Style="{StaticResource FieldLabelStyle}" />
                                        <NumberBox x:Name="EventEasingRightBox" Minimum="0" Maximum="1" SmallChange="0.05"
                                                   SpinButtonPlacementMode="Hidden" ValueChanged="OnEventEasingBoundChanged" />
                                    </StackPanel>
                                </Grid>
                                <controls:EventCurveGraph x:Name="EventCurvePreview" Height="170"
                                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <Grid x:Name="EventActionGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto"
                                  HorizontalAlignment="Stretch">
                                <Button Grid.Row="0" Grid.Column="0" Content="粘合前一事件" Margin="0,0,4,4"
                                        Click="OnEventStickClick" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="0" Grid.Column="1" Content="切割事件" Margin="4,0,0,4"
                                        Click="OnEventCutClick" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="0" Content="首尾交换" Margin="0,4,4,4"
                                        Click="OnEventSwapClick" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" Content="递推" Margin="4,4,0,4"
                                        Click="OnEventRecurrenceClick" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="2" Grid.Column="0" Content="拆分" Margin="0,4,4,0"
                                        Click="OnEventSplitClick" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="2" Grid.Column="1" Content="删除事件" Margin="4,4,0,0"
                                        Click="OnDeleteEventClick" HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>

                        <!-- 判定线列表 -->
                        <Grid x:Name="LinesPanel" Padding="14" Visibility="Collapsed" RowDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Row="0" Text="判定线列表" Style="{StaticResource SectionTitleStyle}" />
                            <ListView x:Name="LineList" Grid.Row="1" SelectionMode="Single"
                                      SelectionChanged="OnLineListSelectionChanged" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button Content="新增判定线" Click="OnAddLineClick" />
                                <Button Content="删除判定线" Click="OnRemoveLineClick" />
                            </StackPanel>
                        </Grid>

                        <!-- 谱面信息 -->
                        <StackPanel x:Name="ChartPanel" Padding="14" Spacing="10" Visibility="Collapsed">
                            <TextBlock Text="谱面信息" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="歌曲名" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SongNameBox" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="艺术家" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="SongArtistBox" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="谱面名" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="ChartNameBox" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="难度" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox x:Name="DifficultyBox" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="基础 BPM" Style="{StaticResource FieldLabelStyle}" />
                                <NumberBox x:Name="BpmBox" Minimum="1" Maximum="999" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnBpmChanged" />
                            </StackPanel>
                            <TextBlock Text="速度表" Style="{StaticResource SectionTitleStyle}" Margin="0,8,0,0" />
                            <ListView x:Name="BpmList" Height="150" SelectionMode="Single" />
                        </StackPanel>
                      </Grid>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="3" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" Padding="16,6" MinHeight="38">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="CopyButton" Click="OnCopyClick" ToolTipService.ToolTip="复制 (Ctrl+C)">
                        <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                    </Button>
                    <Button x:Name="CutButton" Click="OnCutClick" ToolTipService.ToolTip="剪切 (Ctrl+X)">
                        <FontIcon Glyph="&#xE8C6;" FontSize="15" />
                    </Button>
                    <Button x:Name="PasteButton" Click="OnPasteClick" ToolTipService.ToolTip="粘贴 (Ctrl+V)">
                        <FontIcon Glyph="&#xE77F;" FontSize="15" />
                    </Button>
                    <Button x:Name="MirrorButton" Click="OnMirrorClick" ToolTipService.ToolTip="镜像 (Ctrl+M)">
                        <FontIcon Glyph="&#xE8A1;" FontSize="15" />
                    </Button>
                    <Button x:Name="DeleteButton" Click="OnDeleteSelectionClick" ToolTipService.ToolTip="删除 (Delete)">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" />
                    </Button>
                    <Button x:Name="ClearClipboardButton" Click="OnClearClipboardClick" ToolTipService.ToolTip="清空剪贴板">
                        <FontIcon Glyph="&#xE711;" FontSize="15" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="SelectionInfo" Grid.Column="1" Style="{StaticResource StatusTextStyle}"
                           Margin="16,0,0,0" Text="未选中" />
                <TextBlock x:Name="TimeReadout" Grid.Column="2" Style="{StaticResource StatusTextStyle}"
                           Margin="18,0,0,0" Text="0.00s / 0.00s" />
                <TextBlock x:Name="BeatReadout" Grid.Column="3" Style="{StaticResource StatusTextStyle}"
                           Margin="18,0,0,0" Text="拍 0.00" />
                <Slider x:Name="Scrubber" Grid.Column="4" Margin="24,0,24,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" StepFrequency="0.001" />
                <TextBlock x:Name="BpmReadout" Grid.Column="5" Style="{StaticResource StatusTextStyle}"
                           Text="120 BPM" />
                <TextBlock x:Name="StatusReadout" Grid.Column="6" Style="{StaticResource StatusTextStyle}"
                           Margin="18,0,0,0" Text="就绪" />
            </Grid>
        </Border>

        <!-- 设置子页面：覆盖整个主窗口，关闭前无法操作主页面 -->
        <Grid x:Name="SettingsOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
              Background="#C0000000">
            <Border Width="680" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="12">
                <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}" Click="OnCloseSettingsClick"
                                ToolTipService.ToolTip="关闭">
                            <FontIcon Glyph="&#xE711;" FontSize="15" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,10">
                        <Button x:Name="ImportSkinButton" Content="导入资源包" Click="OnImportSkinClick"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="ApplySkinButton" Content="应用此皮肤" Click="OnApplySkinClick" />
                        <Button x:Name="DeleteSkinButton" Content="删除" Click="OnDeleteSkinClick" />
                        <TextBlock x:Name="SkinHint" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center"
                                   Text="导入后立即生效，内置资源包不可删除。" />
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <ListView x:Name="SkinList" SelectionMode="Single" SelectionChanged="OnSkinSelectionChanged" />
                        <Border Grid.Column="1" Width="220" Padding="14" Margin="12,0,0,0"
                                Style="{StaticResource PanelCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="预览" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="SkinPreviewInfo" Style="{StaticResource StatusTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="SkinDescription" Style="{StaticResource StatusTextStyle}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="SettingsStatus" Style="{StaticResource StatusTextStyle}"
                               Margin="0,12,0,0" Text="准备就绪。" />
                </Grid>
            </Border>
        </Grid>

        <!-- 主界面特色功能导航页：覆盖工具栏/工作区/底栏，保留标题栏可拖动。
             点击「开始」进入编辑器；命令行带谱面参数时由代码直接跳过。 -->
        <Grid x:Name="LandingOverlay" Grid.Row="1" Grid.RowSpan="3" Visibility="Visible">
            <views:LandingPage x:Name="Landing" />
        </Grid>
    </Grid>
</Window>
