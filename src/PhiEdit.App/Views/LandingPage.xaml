<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PhiEdit.App.Views.LandingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="760">

    <!-- WinUI 3 原生 NavigationView：与系统设置应用同款侧栏 -->
    <NavigationView x:Name="RootNavigation"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    SelectionChanged="OnNavigationSelectionChanged"
                    OpenPaneLength="248"
                    Background="{ThemeResource AppBackgroundBrush}">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavLibrary" Tag="library" Content="谱面库">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8B7;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavStart" Tag="start" Content="开始" IsSelected="True">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavRender" Tag="render" Content="渲染">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7B3;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="NavSettings" Tag="settings" Content="设置">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavAbout" Tag="about" Content="关于">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7F2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="NavExit" Tag="exit" Content="退出">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7E8;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="44,40,44,40" MaxWidth="1000" HorizontalAlignment="Left">

                <!-- 开始页 -->
                <StackPanel x:Name="StartPanel" Visibility="Visible">
                    <TextBlock Text="欢迎使用 PhiEdit Enhanced Pro" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="原生 Windows 制谱器 · 编辑与实时预览一体化" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />

                    <Border Style="{StaticResource PanelCardStyle}" Margin="0,0,0,18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="快速开始" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="从工具栏新建谱面，或打开已有的 RPE JSON / PEZ 谱面包。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                <Button Content="新建谱面" Click="OnNewChartClick" Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="打开谱面" Click="OnOpenChartClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="进入编辑器" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="继续当前谱面，直接进入编辑工作区。"
                                       FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="开始编辑" Click="OnStartClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 谱面库页 -->
                <StackPanel x:Name="LibraryPanel" Visibility="Collapsed">
                    <TextBlock Text="谱面库" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="本地谱面管理（规划中）" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="即将推出" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="谱面库功能尚未实现。你仍可通过工具栏打开本地谱面文件。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="打开本地谱面" Click="OnOpenChartClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 渲染页 -->
                <StackPanel x:Name="RenderPanel" Visibility="Collapsed">
                    <TextBlock Text="渲染" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="实时预览与导出（规划中）" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="实时预览" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="编辑区已嵌入实时预览；独立预览窗口可从工具栏打开。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Button Content="打开预览窗口" Click="OnOpenPreviewClick" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 设置页：系统设置风格 + 搜索 -->
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />

                    <AutoSuggestBox x:Name="SettingsSearch" Grid.Row="1" PlaceholderText="查找设置"
                                    QueryIcon="Find" TextChanged="OnSettingsSearchChanged"
                                    Margin="0,4,0,20" HorizontalAlignment="Left" Width="420" />

                    <StackPanel Grid.Row="2" Spacing="10">
                        <!-- 资源包设置卡片 -->
                        <Border Style="{StaticResource PanelCardStyle}" x:Name="SkinSettingsCard">
                            <StackPanel Spacing="10">
                                <TextBlock Text="音符资源包" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="导入、应用或删除音符皮肤资源包，编辑区与实时预览同步生效。"
                                           FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="导入资源包" Click="OnImportSkinClick" Style="{StaticResource AccentButtonStyle}" />
                                    <Button Content="应用此皮肤" Click="OnApplySkinClick" />
                                    <Button Content="删除" Click="OnDeleteSkinClick" />
                                </StackPanel>
                                <ListView x:Name="SkinList" SelectionMode="Single" SelectionChanged="OnLandingSkinSelectionChanged"
                                          MaxHeight="180" />
                                <TextBlock x:Name="SkinPreviewInfo" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="SkinDescription" Style="{StaticResource StatusTextStyle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="LandingSettingsStatus" Style="{StaticResource StatusTextStyle}" Text="准备就绪。" />
                            </StackPanel>
                        </Border>
                        <!-- 更多设置占位卡片（可被搜索过滤） -->
                        <Border Style="{StaticResource PanelCardStyle}" x:Name="PreviewSettingsCard">
                            <StackPanel Spacing="8">
                                <TextBlock Text="实时预览" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="编辑区下方铺满实时预览，半透明网格叠加；可从工具栏打开独立预览窗口。"
                                           FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCardStyle}" x:Name="AboutSettingsCard">
                            <StackPanel Spacing="8">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="SettingsVersionText" Text="v1.9.0_BETA1" FontSize="13"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SettingsNoResult" Text="没有找到匹配的设置。" Visibility="Collapsed"
                                   Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </Grid>

                <!-- 关于页 -->
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                    <TextBlock Text="关于" FontSize="26" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,0,0,8" />
                    <TextBlock Text="PhiEdit Enhanced Pro" FontSize="14"
                               Foreground="{ThemeResource TextSecondaryBrush}" Margin="0,0,0,28" />
                    <Border Style="{StaticResource PanelCardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="版本信息" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AboutVersion" Text="v1.9.0_BETA1" FontSize="14"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                            <TextBlock Text="基于 Re:PhiEdit Next 逻辑重制的原生 WinUI 3 制谱器。"
                                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Text="参考源码遵循 PolyForm-Noncommercial-1.0.0 许可。"
                                       FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </NavigationView>
</UserControl>
