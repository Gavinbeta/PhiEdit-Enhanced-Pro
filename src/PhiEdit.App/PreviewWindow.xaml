<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="PhiEdit.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PhiEdit.App.Controls"
        Title="实时预览 — 整份谱面">

    <Grid Background="#FF0C0E13" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#FF171B23" BorderBrush="#FF303745" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Padding="10,6" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="PlayButton" Width="72" Click="OnPlayClick" Content="播放" />
                <Button x:Name="StopButton" Width="72" Click="OnStopClick" Content="回到开头" />
                <Button x:Name="AudioButton" Width="56" Content="音频">
                    <Button.Flyout>
                        <Flyout Opening="OnAudioFlyoutOpening">
                            <ScrollViewer MaxHeight="420">
                                <StackPanel x:Name="AudioPanel" Width="420" Padding="4" Spacing="8" />
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBlock Text="背景亮度" FontSize="12" Foreground="#FF8FA0B8" VerticalAlignment="Center" />
                <Slider x:Name="BackgroundBrightnessSlider" Width="110" Minimum="0" Maximum="100"
                        Value="100" SmallChange="1" ValueChanged="OnBackgroundBrightnessChanged"
                        VerticalAlignment="Center" />
                <TextBlock x:Name="TimeReadout" Text="0.000 s" FontSize="13" Foreground="#FFD8E0EC"
                           VerticalAlignment="Center" MinWidth="150" />
                <Slider x:Name="SeekSlider" Width="180" Minimum="0" Maximum="60" SmallChange="0.1"
                        ValueChanged="OnSeekSliderChanged" VerticalAlignment="Center" />
                <ComboBox x:Name="RateBox" Width="72" SelectedIndex="1" SelectionChanged="OnRateChanged"
                          VerticalAlignment="Center">
                    <ComboBoxItem Content="0.5x" />
                    <ComboBoxItem Content="1.0x" />
                    <ComboBoxItem Content="2.0x" />
                </ComboBox>
                <CheckBox x:Name="FollowEditorCheck" Content="跟随编辑位置" IsChecked="True"
                          Foreground="#FFD8E0EC" VerticalAlignment="Center" />
                <TextBlock x:Name="AudioStatus" Text="音频未加载" FontSize="12" Foreground="#FF8FA0B8"
                           VerticalAlignment="Center" MinWidth="110" />
                <TextBlock Text="背景音与音符音效分层播放；每条判定线可独立控制。"
                           FontSize="12" Foreground="#FF8FA0B8" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <controls:PreviewCanvas x:Name="PreviewSurface" Grid.Row="1" />
    </Grid>
</Window>
